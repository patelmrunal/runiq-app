{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "tasks:catalog:dry": "node scripts/sync_phase3_templates.js --project=runiq-dev",
    "tasks:catalog:apply": "node scripts/sync_phase3_templates.js --project=runiq-dev --apply",
    "tasks:catalog:apply:deactivate": "node scripts/sync_phase3_templates.js --project=runiq-dev --apply --deactivate-missing",
    "backfill:sparse-gps:dry": "node scripts/backfill_sparse_gps_runs.js --project=runiq-dev",
    "backfill:sparse-gps:apply": "node scripts/backfill_sparse_gps_runs.js --project=runiq-dev --apply"
  },
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
